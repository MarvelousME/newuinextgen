{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextgentutors.local/schemas/capability.schema.json",
  "title": "Capability Declaration",
  "type": "object",
  "required": [
    "capabilityId",
    "name",
    "description",
    "provider",
    "version",
    "contract",
    "protocol",
    "requiredPermissions",
    "inputSchema",
    "outputSchema",
    "availability",
    "tenantScope",
    "lifecycleState",
    "tags"
  ],
  "additionalProperties": true,
  "properties": {
    "capabilityId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "provider": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "contract": { "type": "string", "minLength": 1 },
    "protocol": {
      "type": "string",
      "enum": ["rest", "grpc", "event", "command", "query", "shortcode", "internal", "mcp", "webhook"]
    },
    "requiredPermissions": { "type": "array", "items": { "type": "string" } },
    "inputSchema": { "type": "string" },
    "outputSchema": { "type": "string" },
    "availability": { "type": "string", "enum": ["available", "deprecated", "disabled", "planned"] },
    "tenantScope": { "type": "string", "enum": ["global", "tenant", "user"] },
    "lifecycleState": { "type": "string", "enum": ["draft", "active", "retired"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sla": { "type": "string" }
  }
}
