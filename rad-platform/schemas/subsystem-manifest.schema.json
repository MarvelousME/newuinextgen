{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextgentutors.local/schemas/subsystem-manifest.schema.json",
  "title": "Subsystem Manifest",
  "type": "object",
  "required": [
    "bridgeManifestVersion",
    "system",
    "runtime",
    "lifecycle",
    "capabilities",
    "contracts",
    "permissions",
    "data",
    "dependencies",
    "health",
    "observability",
    "configuration",
    "compatibility"
  ],
  "additionalProperties": false,
  "properties": {
    "bridgeManifestVersion": { "type": "string", "const": "1.0" },
    "system": {
      "type": "object",
      "required": ["id", "name", "version", "description", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["type", "entrypoint"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["wordpress-theme", "wordpress-plugin", "service", "library", "modular"]
        },
        "entrypoint": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["installable", "enableable", "disableable", "upgradeable", "rollbackSupported"],
      "additionalProperties": false,
      "properties": {
        "installable": { "type": "boolean" },
        "enableable": { "type": "boolean" },
        "disableable": { "type": "boolean" },
        "upgradeable": { "type": "boolean" },
        "rollbackSupported": { "type": "boolean" }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["provides", "consumes"],
      "additionalProperties": false,
      "properties": {
        "provides": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" }
        },
        "consumes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" }
        }
      }
    },
    "contracts": {
      "type": "object",
      "required": ["rest", "grpc", "events", "commands", "queries"],
      "additionalProperties": false,
      "properties": {
        "rest": { "type": "array", "items": { "type": "string" } },
        "grpc": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } },
        "queries": { "type": "array", "items": { "type": "string" } }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["required", "optional"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "data": {
      "type": "object",
      "required": ["owns", "reads"],
      "additionalProperties": false,
      "properties": {
        "owns": { "type": "array", "items": { "type": "string" } },
        "reads": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["required", "optional"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "health": {
      "type": "object",
      "required": ["readiness", "liveness"],
      "additionalProperties": false,
      "properties": {
        "readiness": { "type": "string" },
        "liveness": { "type": "string" }
      }
    },
    "observability": {
      "type": "object",
      "required": ["logs", "metrics", "traces"],
      "additionalProperties": false,
      "properties": {
        "logs": { "type": "string" },
        "metrics": { "type": "string" },
        "traces": { "type": "string" }
      }
    },
    "configuration": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["minimumPlatformVersion"],
      "additionalProperties": false,
      "properties": {
        "minimumPlatformVersion": { "type": "string" }
      }
    }
  }
}
