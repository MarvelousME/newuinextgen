{
  "name": "nextgentutors-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright E2E workflow tests for NextGen Tutors REVAMP",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:phase14": "playwright test workflows/phase14-demo-walkthrough.spec.ts --headed",
    "test:phase14:ci": "playwright test workflows/phase14-demo-walkthrough.spec.ts",
    "test:ai-bridge": "playwright test workflows/ai-integration-bridge.spec.ts",
    "test:all-headed": "playwright test --headed --workers=1",
    "test:workflows-headed": "playwright test workflows --headed --workers=1",
    "test:system-headed": "playwright test workflows/system-verification.spec.ts --headed --workers=1",
    "test:system": "playwright test workflows/system-verification.spec.ts --workers=1",
    "test:dashboards-headed": "playwright test workflows/blueprint-wf25-dashboards.spec.ts --headed --workers=1",
    "test:business-headed": "playwright test workflows/business-details.spec.ts --headed --workers=1",
    "test:mission-control-headed": "playwright test workflows/mission-control.spec.ts --headed --workers=1",
    "test:intelligence-headed": "playwright test workflows/intelligence-platform.spec.ts --headed --workers=1",
    "test:unified-admin-headed": "playwright test workflows/unified-admin.spec.ts --headed --workers=1",
    "test:phase14:seed": "playwright test workflows/phase14-demo-walkthrough.spec.ts --headed -g \"Section 0\"",
    "report": "playwright show-report reports/html",
    "summarize": "node ../scripts/summarize-playwright-report.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2"
  }
}
