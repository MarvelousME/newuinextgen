# NextGen Tutors — Docker WordPress (newuinextgen)
# Copy to .env:  copy .env.example .env
# Then replace every CHANGE_ME_* value with strong local secrets. Never commit .env.

COMPOSE_PROJECT_NAME=newuinextgen

# WordPress site (staging default :8890)
WP_PORT=8890
PMA_PORT=8082
# SEC-001: keep 127.0.0.1 so phpMyAdmin is not LAN/WAN reachable. Override to 0.0.0.0 only on trusted private hosts.
PMA_BIND=127.0.0.1
WP_URL=http://localhost:8890
WP_TITLE=NextGen Tutors
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=CHANGE_ME_WP_ADMIN_PASSWORD
WP_ADMIN_EMAIL=admin@nextgentutors.local

# Database (internal to Docker network)
# MYSQL_DATABASE / MYSQL_USER may stay as non-secret names; passwords must be unique strong values.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# Agent Gateway (Compose service agent-gateway → WordPress via Docker DNS)
NGT_GATEWAY_HOST_PORT=8787
NGT_AGENT_GATEWAY_URL=http://agent-gateway:8787
NGT_GATEWAY_SHARED_SECRET=CHANGE_ME_GATEWAY_SECRET
NGT_GATEWAY_KILL_SWITCH=0

# Optional Memory Core profile (docker/memory) — SQLite is NOT multi-node HA
# MEMORY_CORE_HOST_PORT=8420
# TDAI_GATEWAY_API_KEY=
# MEMORY_LLM_API_KEY=
# MEMORY_LLM_BASE_URL=
# MEMORY_CORE_IMAGE=agentmemory/memory-core:latest

# Optional Talent NLP similarity sidecar (docker/talent) — not an LLM gateway
# TALENT_NLP_HOST_PORT=8090

# Ecosystem platform overlay (docker-compose.ecosystem.yml)
# SEC-001: bind management ports to loopback only. Do not set ECOSYSTEM_BIND=0.0.0.0 on LAN/VPS without auth hardening.
ECOSYSTEM_BIND=127.0.0.1
ECOSYSTEM_API_PORT=8790
# Required for /api/v1/* — must be a strong secret (not platform-super-admin, admin, changeme)
ECOSYSTEM_API_TOKEN=
ECOSYSTEM_RABBIT_PORT=15672
ODOO_PORT=8069
# Odoo login name (not a secret). Passwords must be set in docker/.env — never commit them.
# Weak values (admin, odoo, changeme, password) are rejected by the adapter.
ODOO_ADMIN_USER=admin
ODOO_ADMIN_PASSWORD=
ODOO_MASTER_PASSWORD=

# NextGenTutors-Companion plugin (optional override — defaults to repo copy)
# COMPANION_PLUGIN_PATH=C:/path/to/NextGenTutors-Companion

# Plugin Manager local zip drop folder (host path — mounted to wp-content/ngcpm-packages)
# Copy .zip files into docker/ngcpm-packages/ before starting the stack.

# Optional WPBakery (js_composer) — licensed zip path on host for install-wpbakery.sh
# WPBAKERY_ZIP_PATH=C:/path/to/js_composer.zip
