{
  "name": "ecosystem-platform",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ecosystem-platform",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "services/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@ecosystem/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@ecosystem/nextgen-ui": {
      "resolved": "packages/nextgen-ui",
      "link": true
    },
    "node_modules/@ecosystem/odoo-adapter": {
      "resolved": "packages/odoo-adapter",
      "link": true
    },
    "node_modules/@ecosystem/platform-api": {
      "resolved": "services/platform-api",
      "link": true
    },
    "node_modules/@ecosystem/platform-core": {
      "resolved": "packages/platform-core",
      "link": true
    },
    "node_modules/yaml": {
      "version": "2.9.0",
      "resolved": "https://registry.npmjs.org/yaml/-/yaml-2.9.0.tgz",
      "integrity": "sha512-2AvhNX3mb8zd6Zy7INTtSpl1F15HW6Wnqj0srWlkKLcpYl/gMIMJiyuGq2KeI2YFxUPjdlB+3Lc10seMLtL4cA==",
      "license": "ISC",
      "bin": {
        "yaml": "bin.mjs"
      },
      "engines": {
        "node": ">= 14.6"
      },
      "funding": {
        "url": "https://github.com/sponsors/eemeli"
      }
    },
    "packages/contracts": {
      "name": "@ecosystem/contracts",
      "version": "0.1.0"
    },
    "packages/nextgen-ui": {
      "name": "@ecosystem/nextgen-ui",
      "version": "0.1.0"
    },
    "packages/odoo-adapter": {
      "name": "@ecosystem/odoo-adapter",
      "version": "0.1.0",
      "dependencies": {
        "@ecosystem/contracts": "0.1.0"
      }
    },
    "packages/platform-core": {
      "name": "@ecosystem/platform-core",
      "version": "0.1.0",
      "dependencies": {
        "@ecosystem/contracts": "0.1.0",
        "yaml": "^2.6.1"
      }
    },
    "services/platform-api": {
      "name": "@ecosystem/platform-api",
      "version": "0.1.0",
      "dependencies": {
        "@ecosystem/contracts": "0.1.0",
        "@ecosystem/odoo-adapter": "0.1.0",
        "@ecosystem/platform-core": "0.1.0"
      }
    }
  }
}
